NODE_ENV=production
PORT=10000

DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DB_NAME
DATABASE_HOST=HOST
DATABASE_PORT=3306
DATABASE_USER=USER
DATABASE_PASSWORD=PASSWORD
DATABASE_NAME=DB_NAME

JWT_SECRET=change-me
JWT_EXPIRATION=1h
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRATION=7d
JWT_RESET_SECRET=change-me
JWT_RESET_EXPIRATION=1h
JWT_VERIFY_SECRET=change-me
JWT_VERIFY_EXPIRATION=1h
JWT_VERIFY_REFRESH_SECRET=change-me
JWT_VERIFY_REFRESH_EXPIRATION=7d
JWT_VERIFY_RESET_SECRET=change-me
JWT_VERIFY_RESET_EXPIRATION=1h

GOOGLE_MAPS_API_KEY=
REDIS_HOST=
REDIS_PORT=6379

# JSON stringified service account content
FIREBASE_SERVICE_ACCOUNT_JSON=
