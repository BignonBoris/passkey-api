// generator client {
//   provider = "prisma-client" 
//   engineType = "library"
// }
generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/client"
  engineType = "library"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  client
  driver
  admin
}

model User {
  id       String  @id @default(uuid())
  phone    String  @unique
  password String?
  name     String?
  role     String? @default("usager") // Changé de UserRole à String
  // role          UserRole @default(client)
  isActive Boolean @default(false)

  // Driver fields
  isAvailable Boolean @default(false)
  latitude    Float?
  longitude   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
